# ==============================================================================
# VennFlow AI - Veritabanı (PostgreSQL / UGESUDKOKPİT) & Uygulama Yapılandırması
# ==============================================================================
# Bu dosya "app.py" ile AYNI DİZİNDE (c:\Users\ismailyilmaz\Desktop\mcp tool v1\.env)
# yer almalıdır. Gerçek ortamınız için bu dosyayı ".env" olarak kaydedebilirsiniz.

# 0. Uygulama & Sunucu Ağ Yapılandırması (Port & Host)
APP_PORT=9000
APP_HOST=0.0.0.0
# Alternatif: PORT=9000

# 1. PostgreSQL Bağlantı Bilgileri (DBeaver / UGESUDKOKPİT)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ud_kokpit
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_CONNECT_TIMEOUT=4

# 2. Şema ve Tablo İsimleri
DB_SCHEMA=teslimat_md
DB_BAKIYE_TABLE=bakiye_siparis
DB_KPI_TABLE=dryrun_fkt_skt_kpi

# 3. Opsiyonel: Tek satırlık DSN
# UD_KOKPIT_DB_DSN=host=localhost port=5432 dbname=ud_kokpit user=postgres password=***

# 4. Yetkilendirme / Admin Rol ve Kullanıcı Tanımları
ADMIN_ROLES=admin,yönetici,yonetici,superuser,system_admin,sistem yöneticisi
ADMIN_USERS=

# 5. ASELSAN AselixAI & Chat Asistanı Yapılandırması
# API anahtarı verilirse backend ve chat asistanı doğrudan bu anahtarı kullanır.
ASELIX_API_KEY=
# Milli Ağ: https://api.aselixai.aselsan.com.tr/v1
# Aynet Ağı: https://agate.aselsan.com.tr/send/milli/api.aselixai/v1
ASELIX_BASE_URL=https://api.aselixai.aselsan.com.tr/v1
ASELIX_MODEL=aselix-llm-v1
# İstek zaman aşımı koruma süresi (saniye) - Önerilen: 90
ASELIX_TIMEOUT=90
# Kıyaslama batch boyutu (satır) - AselixAI'den hızlı dönüş ve odaklı eşleştirme için önerilen: 5
ASELIX_BATCH_SIZE=5
